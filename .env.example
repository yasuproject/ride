APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when the site is served over HTTPS (auto-enabled when APP_ENV=production).
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# SESSION_HTTP_ONLY=true

# --- Security hardening -------------------------------------------------
# Mobile bearer tokens expire after this many minutes (default 7 days).
SANCTUM_TOKEN_EXPIRATION=10080
# Optional prefix so leaked tokens are detected by secret scanners.
SANCTUM_TOKEN_PREFIX=
# Browser origins allowed to call the API (comma-separated). Empty blocks all
# cross-origin browser requests; native mobile apps are unaffected.
CORS_ALLOWED_ORIGINS=
# Security events are written to storage/logs/security.log.
LOG_SECURITY_DAYS=90
# First administrator, created only when seeding with a non-empty password.
# There is no default password.
ADMIN_EMAIL=admin@mkride.local
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMSEthiopia provider endpoint (the API key is managed in the admin panel and
# stored encrypted in the database, never in this file).
# v2: https://smsethiopia.com/api/v2/sms/send  (v1: https://smsethiopia.com/api/sms/send)
SMSETHIOPIA_API_URL=https://smsethiopia.com/api/v2/sms/send
